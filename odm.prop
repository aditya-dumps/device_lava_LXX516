# Bluetooth
persist.bluetooth.a2dp_offload.disabled=true
ro.bluetooth.a2dp_offload.supported=false

# Display
debug.sf.enable_changezorder_flag=1
debug.sf.high_fps_late_app_phase_offset_ns=-4000000
debug.sf.high_fps_late_sf_phase_offset_ns=-3000000
debug.sf.hwc.min.duration=3000000

# Radio
persist.radio.multisim.config=dsds
persist.vendor.radio.feature.bitmask=8
persist.vendor.radio.phone_count=2

# Miscellaneous
debug.fw.set_system_thread_vip_task=1
persist.vendor.cam.faceid.version=1
persist.vendor.cam.morphoHdr.enable=false
persist.vendor.cam.morphoMfnr.enable=false
persist.vendor.faceid.livenessgrade=2
qemu.hw.mainkeys=0
ro.media.xml_variant.codecs=_c2_secure
ro.media.xml_variant.codecs_performance=_c2_secure
ro.odm.ab_ota_partitions=boot,ch_sys,dtbo,init_boot,l_agdsp,mmcblk0boot1,nr_deltanv,nr_fixnv1,nr_fixnv2,nr_modem,nr_phy,odm,pm_sys,product,sdc,sml,system,system_dlkm,system_ext,teecfg,trustos,uboot,vbmeta,vbmeta_odm,vbmeta_product,vbmeta_system,vbmeta_system_ext,vbmeta_vendor,vendor,vendor_boot,vendor_dlkm
ro.product.hardware=ums9621_1h10
ro.product.property_source_order=odm,product,vendor,system_ext,system
ro.recovery.ui.dropscreen=1
ro.recovery.ui.margin_height=45
