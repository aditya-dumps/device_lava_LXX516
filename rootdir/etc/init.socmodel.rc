on early-init && property:ro.boot.auto.efuse=UMS9621S
    setprop ro.soc.model UMS9621S
    setprop ro.unicpu.model T8200

on early-init && property:ro.boot.auto.efuse=UMS9621
    setprop ro.soc.model UMS9621

on early-init && property:ro.boot.auto.efuse=-1
    setprop ro.soc.model UMS9621S
    setprop ro.unicpu.model T8200
